# Copie este arquivo para .env e preencha com SEUS valores reais.
# NUNCA commite o .env (ele está no .gitignore). Não armazene senhas aqui:
# a coleta usa uma chave SSH (a senha do servidor só serve na instalação e não é guardada).
# O ./dashboard instalar preenche este arquivo; edite à mão só se souber o que está fazendo.
SSH_HOST=seu_host_ou_alias_ssh
# Configuração SSH própria do painel (ssh -F), sempre dentro de data/. Vazio = usa o ~/.ssh/config (V1).
SSH_CONFIG=
# restrito = a chave do painel só roda a coleta (command= no authorized_keys do servidor);
# direto = o painel envia o comando inteiro (V1, ou servidor ainda não preparado).
SSH_ACESSO=direto
POLL_INTERVAL=60000
PORT=3000
HISTORY_LIMIT=4320
# Histórico da V1 a migrar (1 vez, com backup). A V2 grava em data/history/ e data/rollup/.
HISTORY_FILE=data/history.json
LOG_FILE=data/dashboard.log
# Interface de rede a monitorar (ex.: enpXsY). Vazio = seção Rede omitida.
NET_IF=
# Mount points monitorados, separados por espaço (ex.: / /mnt/disco1).
DISK_MOUNTS=/
# Discos para leitura/gravação (I/O), separados por espaço (ex.: sda sdb). Vazio = omitido.
DISK_DEVS=
# Discos com teste de saúde SMART (1x por hora). Sem esta linha = os mesmos de DISK_DEVS;
# presente e vazia = nenhum. O sudo do servidor libera só estes (smartctl -H por disco).
# SMART_DEVS=sda
# Serviços systemd monitorados, separados por espaço (ex.: smbd nmbd). Vazio = omitido.
SERVICES=
# Token de acesso. Se preenchido, o navegador pede o token uma vez (sessão de 30 dias) e
# scripts usam Authorization: Bearer <token>. O ./dashboard instalar gera um automático.
# O ./dashboard abrir entra sem digitar o token (link de uso único).
DASH_TOKEN=
# Limiares dos alertas (valores fora da faixa voltam ao padrão, com aviso no log).
# Disco e RAM em % usado (50–99), temperatura em °C (30–110).
ALERT_DISK_PCT=90
ALERT_RAM_PCT=90
ALERT_TEMP_C=60
# Histerese: o alerta só limpa quando o valor cai este tanto abaixo do limiar (0–20).
ALERT_HYSTERESIS=5
# Coletas seguidas com falha antes de alertar "servidor inacessível" (1–10).
ALERT_OFFLINE_AFTER=2
