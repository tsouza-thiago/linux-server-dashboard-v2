{
  "name": "linux-server-dashboard",
  "version": "2.0.0-alpha.7",
  "description": "Dashboard de monitoramento em tempo real de servidor Linux via SSH",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "poll": "node server/poller.js --once",
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "capturar-amostra": "node scripts/capturar-amostra.mjs",
    "migrar-v1": "node server/storage/migrate-v1.js",
    "test:e2e": "node --test \"test/e2e/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
