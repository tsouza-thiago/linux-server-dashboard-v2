{
  "name": "linux-server-dashboard",
  "version": "2.2.1",
  "description": "Server Dashboard: painel em tempo real de um servidor Linux, via 1 SSH por minuto",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --max-semi-space-size=2 --optimize-for-size server/index.js",
    "poll": "node server/poller.js --once",
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:seguranca": "node --test \"test/seguranca/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "seguranca": "node scripts/seguranca.mjs",
    "capturar-amostra": "node scripts/capturar-amostra.mjs",
    "migrar-v1": "node server/storage/migrate-v1.js",
    "soak": "node --expose-gc --max-semi-space-size=2 --optimize-for-size scripts/soak-acelerado.mjs",
    "painel-teste": "node --max-semi-space-size=2 --optimize-for-size scripts/painel-teste.mjs",
    "test:e2e": "node --test \"test/e2e/**/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
