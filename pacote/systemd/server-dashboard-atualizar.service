# Server Dashboard — instalar a versão nova já verificada (F9 do #92, ADR 0042, 0044 e 0045).
# Uso único: roda o executor do pacote com o subcomando fixo, sem parâmetro vindo de fora.
# No pacote, fica em /usr/lib/systemd/system/. Não tem [Install]: só o timer (verificar) e o
# painel, pelo polkit (atualizar e voltar), a iniciam.
[Unit]
Description=Server Dashboard: instalar a versão nova já verificada
Documentation=https://github.com/tsouza-thiago/linux-server-dashboard-v2/blob/main/docs/adr/0045-unidades-systemd-do-executor.md

[Service]
Type=oneshot
ExecStart=/opt/server-dashboard/libexec/atualizador atualizar
TimeoutStartSec=10min
MemoryMax=256M
# Só estas pastas aceitam gravação; o resto do sistema, inclusive a pasta base do pacote, é
# só leitura (ProtectSystem=strict).
ReadWritePaths=/opt/server-dashboard/versoes /opt/server-dashboard/estado
# Sem rede: instala a tag que o verificar já trouxe para o repo.git (o Node da etapa 7 muda isto).
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none
# --- Isolamento (ADR 0042, item 7, e ADR 0045). Conferido por test/unit/unidades-systemd.test.js.
User=_server-dashboard
Group=_server-dashboard
UMask=0022
NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
Nice=19
IOSchedulingClass=idle
TasksMax=64
